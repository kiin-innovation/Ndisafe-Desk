# Public address (IP or domain) the relay/rendezvous servers are reachable at.
# Clients will use this value to reach hbbs and hbbr, so it must be the VPS's
# public IP or a DNS name pointing to it. No scheme, no port.
# Example: RELAY_PUBLIC_HOST=203.0.113.10   or   RELAY_PUBLIC_HOST=relay.example.com
RELAY_PUBLIC_HOST=